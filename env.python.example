APP_NAME=praktikant-python
APP_BASE_URL=http://localhost:8000
APP_ENV=development
APP_PORT=8000
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_HOURS=168
COOKIE_NAME=praktika_token
# Пусто = автоматически (Secure при APP_BASE_URL=https://...)
COOKIE_SECURE=
# IP обратного прокси (nginx), которому доверяем X-Forwarded-For. Пусто = без прокси.
TRUSTED_PROXIES=
ADMIN_EMAILS=admin@example.com
POSTGRES_DSN=postgresql+psycopg://postgres:postgres@localhost:5432/praktikant
MAIL_FROM=no-reply@praktika.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
UNISENDER_API_KEY=
UNISENDER_BASE_URL=https://goapi.unisender.ru/ru/transactional/api/v1
# Тестовый код для локальной разработки: работает только при REAL_SEND=false и APP_ENV != production.
# В production: APP_ENV=production, REAL_SEND=true (иначе приложение не стартует).
TEST_BYPASS_CODE=335335
REAL_SEND=false
AUTO_COMPLETE_INTERVAL_SECONDS=60
LOGIN_STEPUP_ALWAYS=false
